<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 打包时 Tauri 会把这里的内容并进 ingwork.app 的 Info.plist。
     听课要用麦克风、录电脑的声音：没有这两句，Mac 不会弹出"允许"，而是直接让软件退出 -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>听课时用麦克风听老师讲课，听写成文字、翻译成中文。设置里打开了才保存录音，只存在这台电脑上。</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>听网课时录下电脑正在播放的声音，听写成文字、翻译成中文。</string>
</dict>
</plist>
