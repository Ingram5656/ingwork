<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 打包时 Tauri 会把这里的内容并进 ingwork.app 的 Info.plist。
     听课要用麦克风：没有这一句，Mac 不会弹出"允许使用麦克风"，而是直接让软件退出 -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>听课时用麦克风听老师讲课，听写成文字、翻译成中文。录音不保存。</string>
</dict>
</plist>
